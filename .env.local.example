# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Address autocomplete (used server-side by /api/address-search).
# Free tier from https://www.geoapify.com/ — sign up for a key.
GEOAPIFY_API_KEY=

# Supabase (persistens + inloggning). Project Settings → API i din Supabase-dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
